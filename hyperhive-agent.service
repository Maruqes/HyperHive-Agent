[Unit]
Description=HyperHive Support Linux collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hyperhive-agent
Environment=COLLECTOR_ENV=/etc/hyperhive-agent/.env
StateDirectory=hyperhive-agent
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/hyperhive-agent/collector.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
